{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "agent-tollbooth-402-clearinghouse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "tollbooth.redcenterstudio.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "PRO_PASS_URL": "https://tollbooth.redcenterstudio.com/pay",
    "ENVIRONMENT": "production",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_placeholder_copy_from_stripe_dashboard",
    "STRIPE_WEBHOOK_ENDPOINT_ID": "we_1UcxFBHEzENMJ5rpKmaaJeGp",
    "STRIPE_PRICE_TOPUP_10": "price_1UcxIZHEzENMJ5rpmbOcFzrV",
    "STRIPE_PRICE_PRO_PASS": "price_1UcxKKHEzENMJ5rpCd2Sl0Sw",
    "STRIPE_PRICE_AGENCY_PASS": "price_1UcxM1HEzENMJ5rp5lMD64ZI",
    "STRIPE_PAYMENT_LINK_TOPUP_10": "https://buy.stripe.com/fZubJ1eKU4Mk7VL5eKbEA0h",
    "STRIPE_PAYMENT_LINK_PRO_PASS": "https://buy.stripe.com/14AcN5cCM5Qo2BrdLgbEA0i",
    "STRIPE_PAYMENT_LINK_AGENCY_PASS": "https://buy.stripe.com/cNicN5eKUdiQgshfTobEA0j"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tollbooth-clearinghouse",
      "database_id": "e703786a-9bf7-4f00-adb1-b90cad5702d1",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "test": {
      "vars": {
        "PRO_PASS_URL": "https://tollbooth.redcenterstudio.com/pay",
        "ENVIRONMENT": "test-sandbox",

// REFERENCE CONFIGURATION ONLY — NEVER RUN wrangler deploy AGAINST LIVE INFRASTRUCTURE
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
  "name": "agent-tollbooth-402-clearinghouse",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "PRO_PASS_URL": "https://tollbooth.redcenterstudio.com/pay",
    "ENVIRONMENT": "reference-local",
    "STRIPE_PRICE_TOPUP_10": "price_1UcwkjHEzENMJ5rpkgIMOa1Y",
    "STRIPE_PRICE_PRO_PASS": "price_1UcwmNHEzENMJ5rpYF5tFfbq",
    "STRIPE_PRICE_AGENCY_PASS": "price_1UcwnZHEzENMJ5rpkGvjqE2j"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tollbooth-clearinghouse-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}

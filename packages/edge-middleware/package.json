{
  "name": "@redcenterstudio/agent-tollbooth-edge",
  "version": "1.2.0",
  "description": "HTTP 402 middleware for Cloudflare Workers and Hono: AI agents pay per call in USDC over x402 V2, straight to your own Base wallet. 0% fee.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Red-Center-Studio/agent-tollbooth-402.git",
    "directory": "packages/edge-middleware"
  },
  "homepage": "https://tollbooth.redcenterstudio.com/pay",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
